<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>TUNABLE-CONSISTENCY</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Overridable build output directory. run_all.sh builds into
             target-script/ so CLI builds never collide with the IDE's
             concurrent compilation into target/. -->
        <build.dir>target</build.dir>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Overridden by the jdk24-plus profile; a harmless no-op flag on
             older JDKs where the real option does not exist. -->
        <sunMiscUnsafeArg>-Dsun.misc.unsafe.flag=unused</sunMiscUnsafeArg>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <grpc.version>1.83.1</grpc.version>
        <protoc.version>3.25.9</protoc.version>
        <junit.jupiter.version>6.1.3</junit.jupiter.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencies>
        <!-- gRPC -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- Logging (was a transitive dependency of the removed jedis) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- Gson for JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>

        <!-- SnakeYAML for the YAML config (parsed into a Gson tree so the
             strict unknown-key rejection works identically for both formats) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- ✅ JUnit 5 (Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ✅ Mockito (for mocking in tests) -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- MongoDB transport (MONGODB_PORT.md): the official async driver; Netty comes via grpc-netty. -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-reactivestreams</artifactId>
            <version>5.11.1</version>
        </dependency>
        <!-- Blocking driver for the driver's cluster administration (hello, setParameter, serverStatus). -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>5.11.1</version>
        </dependency>
    </dependencies>

    <build>
        <directory>${build.dir}</directory>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>

        <plugins>
            <!-- Compile Protobuf + gRPC -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>
                        com.google.protobuf:protoc:${protoc.version}:exe:${os.detected.classifier}
                    </protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>
                        io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}
                    </pluginArtifact>
                    <protoSourceRoot>src/main/resources</protoSourceRoot>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ✅ Ensure tests run with JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- Server nodes write metrics CSVs into the working
                         directory; keep test runs from polluting the repo root. -->
                    <workingDirectory>${project.build.directory}</workingDirectory>
                    <argLine>${sunMiscUnsafeArg}</argLine>
                </configuration>
            </plugin>

            <!-- Fat jar for running on remote machines (run_all_cloudlab.sh):
                 one self-contained artifact, invoked with java -cp. The
                 services transformer merges META-INF/services files, which
                 gRPC needs to find its name resolver and load balancer
                 providers in a shaded jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- The reduced POM is written to the project root whatever
                                 build.dir says, so two sweeps building at once corrupted
                                 each other's copy. Nothing here publishes the artifact. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- protobuf-java 3.x still uses sun.misc.Unsafe memory access, which
             JDK 24+ warns about on every JVM start. This flag acknowledges the
             usage and silences the warning; it only exists on JDK 23+, hence
             the version-gated profile (the default property is a harmless
             no-op system property for older JDKs). -->
        <profile>
            <id>jdk24-plus</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <properties>
                <sunMiscUnsafeArg>--sun-misc-unsafe-memory-access=allow</sunMiscUnsafeArg>
            </properties>
        </profile>
    </profiles>
</project>
